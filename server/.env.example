# Server runtime
PORT=5001
NODE_ENV=development

# Auth
JWT_SECRET=replace_with_a_long_random_secret

# Database (MongoDB)
DATABASE_URL=mongodb://127.0.0.1:27017/finora?directConnection=true

# Email sender (used by report email APIs)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
